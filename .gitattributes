# .gitattributes — line endings, archive exclusions, language stats

# Normalize line endings on commit; check out OS-native
* text=auto eol=lf

# Binary file types — never normalize
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.zip binary
*.pdf binary

# Files that should NOT be included in distribution packages
# (git archive / WP.org plugin zip). composer.json/lock are intentionally
# NOT ignored — bin/build-release.sh needs them to run `composer install`
# and strips them from the final package afterward.
/.editorconfig          export-ignore
/.gitattributes         export-ignore
/.gitignore             export-ignore
/.github                export-ignore
/CODE_OF_CONDUCT.md     export-ignore
/CONTRIBUTING.md        export-ignore
/SECURITY.md            export-ignore
/CHANGELOG.md           export-ignore
/README.md              export-ignore
/plan.md                export-ignore
/tests                  export-ignore
/bin                    export-ignore
/docs                   export-ignore
/docker-compose.yml     export-ignore
/phpunit.xml.dist       export-ignore
/package.json           export-ignore
/package-lock.json      export-ignore
/vite.config.js         export-ignore
/vitest.config.js       export-ignore
/BRAND.md               export-ignore
/brand                  export-ignore
/marketing              export-ignore

# Linguist overrides — accurate language stats on GitHub
*.svg linguist-vendored
brand/* linguist-vendored
marketing/* linguist-documentation
docs/* linguist-documentation
