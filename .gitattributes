# .gitattributes — line endings, archive exclusions, language stats

# Normalize line endings on commit; check out OS-native
* text=auto eol=lf

# Binary file types — never normalize
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.zip binary
*.pdf binary

# Files that should NOT be included in distribution packages
# (composer create-project, WP.org plugin zip, etc.)
/.editorconfig          export-ignore
/.gitattributes         export-ignore
/.gitignore             export-ignore
/.github                export-ignore
/CODE_OF_CONDUCT.md     export-ignore
/CONTRIBUTING.md        export-ignore
/SECURITY.md            export-ignore
/tests                  export-ignore
/docker                 export-ignore
/docs                   export-ignore
/marketing              export-ignore
/phpcs.xml              export-ignore
/phpunit.xml            export-ignore
/.eslintrc*             export-ignore
/.prettierrc*           export-ignore
/vite.config.ts         export-ignore

# Linguist overrides — accurate language stats on GitHub
*.svg linguist-vendored
brand/* linguist-vendored
marketing/* linguist-documentation
docs/* linguist-documentation
